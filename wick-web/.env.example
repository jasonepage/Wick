# wick-web environment. Copy to wick-web/.env and edit.
#   cp .env.example .env
# Vite reads this at build time; only VITE_ prefixed names reach the browser.
# The web client holds no API key. The Gemini key lives on wick-api only.

# WebSocket address of the wick-api server the web client should talk to.
# Leave blank to use the same origin the page was served from (production
# layout, where wick-api serves the built web client), or a local wick-api
# on port 8080 when running `npm run dev`.
VITE_WICK_SERVER=ws://localhost:8080
