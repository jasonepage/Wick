# wick-api environment. Copy to wick-api/.env and fill in your own values.
#   cp .env.example .env
# `npm run dev` and `npm start` load .env automatically (Node's --env-file).
# On a host like Render, set these in the dashboard instead of a file.
# Never commit a real .env; it is gitignored.

# ---- Required for real hot/cold scoring -------------------------------------
# Your own Google Gemini API key (https://aistudio.google.com/apikey).
# Without it the server still runs, but warmth falls back to a rough lexical
# score and the Keeper (question answering) is disabled.
GEMINI_API_KEY=

# ---- Server basics -----------------------------------------------------------
# Port to listen on. Hosts like Render set this for you.
PORT=8080
# Browser origins allowed to open a live WebSocket, comma separated. Native
# apps send no Origin and are always allowed. Add your own domain here.
WICK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Base URL used when building share links (ghost races, invites).
WICK_APP_LINK_BASE=http://localhost:8080
# Apple app identifier (TEAMID.bundle.id) served in the
# apple-app-site-association file for Universal Links. Only matters if you
# ship your own iOS build; leave blank otherwise.
WICK_APPLE_APP_ID=

# ---- Optional knobs (defaults shown) -----------------------------------------
# Debug routes /debug/warmth and /debug/keeper are OFF unless this is set.
# They reveal the secret for any guess and spend Gemini calls, so leave it
# blank in production or use a long random string.
WICK_DEBUG_TOKEN=
# Gemini embedding model(s) to try, in order.
# WICK_EMBED_MODEL=gemini-embedding-001,gemini-embedding-2,text-embedding-004
# Embedding output dimension override (blank = model default).
# WICK_EMBED_DIM=
# Gemini chat model(s) for the Keeper, in order.
# WICK_KEEPER_MODEL=gemini-2.5-flash,gemini-flash-latest,gemini-2.0-flash,gemini-2.5-flash-lite,gemini-1.5-flash
# Retry policy for Gemini calls.
# WICK_EMBED_RETRIES=4
# WICK_EMBED_RETRY_MS=400
# Set to 0 to skip pre-embedding the rank vocabulary at boot (faster startup,
# noisier warmth for the first minutes).
# WICK_PREWARM=1
# Set to 0 to silence the in-memory analytics events.
# WICK_EVENTS=1
# Warmth calibration (cosine bounds) and rank band edges.
# WICK_WARMTH_LO=0.8
# WICK_WARMTH_HI=0.96
# WICK_RANK_BOILING=25
# WICK_RANK_HOT=100
# WICK_RANK_WARM=400
# WICK_RANK_COOL=1200
# WICK_SECRET_MIN_SPREAD=0
# Game clock tick and how long a ready room waits for its second player.
# WICK_TICK_MS=1000
# WICK_READY_GRACE_MS=600000
# Per-IP rate limits (burst, requests per second).
# WICK_HTTP_BURST=40
# WICK_HTTP_RPS=1
# WICK_WS_BURST=30
# WICK_WS_RPS=5
# WICK_CREATE_BURST=12
# WICK_CREATE_RPS=0.5
# WICK_CONN_BURST=15
# WICK_CONN_RPS=1
