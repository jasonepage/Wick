{
  "name": "wick-api",
  "version": "0.1.0",
  "private": true,
  "description": "Wick server: scores guesses for the web game, answers the Keeper, runs live races, and serves guesswick.com.",
  "license": "MPL-2.0",
  "homepage": "https://guesswick.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonepage/Wick.git",
    "directory": "wick-api"
  },
  "bugs": {
    "url": "https://github.com/jasonepage/Wick/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json && cp src/worddata.json dist/worddata.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:all": "npm run build && (cd ../wick-web && npm ci && npm run build) && rm -rf public && mkdir -p public && cp -r ../wick-web/dist/. public/"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "word-list": "^4.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
