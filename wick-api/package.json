{
  "name": "wick-api",
  "version": "0.1.0",
  "private": true,
  "description": "Wick 3.0 backend — free live multiplayer (match server, matchmaking, bots) + OG share preview. Phase 1.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json && cp src/worddata.json dist/worddata.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:all": "npm run build && (cd ../wick-web && npm ci && npm run build) && rm -rf public && mkdir -p public && cp -r ../wick-web/dist/. public/"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "word-list": "^4.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
