<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:guesswick.com</string>
		<string>applinks:jasonepage.github.io</string>
	</array>
	<!-- iCloud key-value storage, for CloudSync.swift (streak / stats / coins /
	     achievements / wardrobe). This entitlement must ALSO be enabled on the
	     App ID: Xcode → target → Signing & Capabilities → + Capability → iCloud
	     → tick "Key-value storage". Without that, signing fails with
	     "Provisioning profile doesn't include the
	     com.apple.developer.ubiquity-kvstore-identifier entitlement." -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Game Center, for GameCenter.swift (leaderboards + achievement mirror).
	     Also needs the capability on the App ID (Signing & Capabilities → +
	     Capability → Game Center) and the leaderboard/achievement ids created in
	     App Store Connect — see the header of GameCenter.swift for the exact
	     list. Until then every call there fails silently and nothing breaks. -->
	<key>com.apple.developer.game-center</key>
	<true/>
</dict>
</plist>
